# Chave mestra (32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA comite o valor real. Se perder, as contas ficam ilegíveis.
MASTER_KEY=

# Origens que podem usar a API/WebSocket (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,https://SEU_CLIENT_ID.discordsays.com

# OAuth Client ID (tipo "Aplicativo da Web") do Google Cloud Console
GOOGLE_CLIENT_ID=

# Cloudflare TURN (opcional, recomendado)
TURN_KEY_ID=
TURN_API_TOKEN=

# Banco Postgres onde as contas ficam salvas (Neon grátis: neon.tech)
# Vazio = arquivo local em DATA_DIR (só para desenvolvimento)
DATABASE_URL=
DATA_DIR=./data

# 1 = atrás de proxy (Render etc.)
TRUST_PROXY=0
